[32m+[m[32m    if (writeFile == NULL) {[m
[32m+[m[32m        printf("Error: could not create test.txt\n");[m
[32m+[m[32m        return 1;[m
[32m+[m[32m    }[m
[32m+[m[32m    fprintf(writeFile, "This is line one\n");[m
[32m+[m[32m    fprintf(writeFile, "This is line two with apple\n");[m
