[32m+[m[32m}[m
[1mdiff --git a/src/myfilefunctions.c b/src/myfilefunctions.c[m
[1mnew file mode 100644[m
[1mindex 0000000..3dc8826[m
[1m--- /dev/null[m
[1m+++ b/src/myfilefunctions.c[m
[36m@@ -0,0 +1,79 @@[m
[32m+[m[32m#include "../include/myfilefunctions.h"[m
[32m+[m[32m#include "../include/mystrfunctions.h"[m
[32m+[m[32m#include <stdlib.h>[m
[32m+[m[32m#include <string.h>[m
[32m+[m
[32m+[m[32mint wordCount(FILE* file, int* lines, int* words, int* chars) {[m
[32m+[m[32m    if (file == NULL) {[m
[32m+[m[32m        return -1;[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    *lines = 0;[m
[32m+[m[32m    *words = 0;[m
[32m+[m[32m    *chars = 0;[m
[32m+[m
[32m+[m[32m    int c;[m
[32m+[m[32m    int inWord = 0;[m
[32m+[m
[32m+[m[32m    while ((c = fgetc(file)) != EOF) {[m
[32m+[m[32m        (*chars)++;[m
[32m+[m
[32m+[m[32m        if (c == '\n') {[m
[32m+[m[32m            (*lines)++;[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        if (c == ' ' || c == '\n' || c == '\t') {[m
[32m+[m[32m            inWord = 0;[m
[32m+[m[32m        } else {[m
[32m+[m[32m            if (inWord == 0) {[m
[32m+[m[32m                (*words)++;[m
[32m+[m[32m                inWord = 1;[m
[32m+[m[32m            }[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    return 0;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mint mygrep(FILE* fp, const char* search_str, char*** matches) {[m
[32m+[m[32m    if (fp == NULL || search_str == NULL) {[m
[32m+[m[32m        return -1;[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    int capacity = 4;[m
[32m+[m[32m    int count = 0;[m
[32m+[m[32m    char** result = malloc(capacity * sizeof(char*));[m
[32m+[m[32m    if (result == NULL) {[m
[32m+[m[32m        return -1;[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    char buffer[1024];[m
[32m+[m
[32m+[m[32m    while (fgets(buffer, sizeof(buffer), fp) != NULL) {[m
[32m+[m[32m        if (strstr(buffer, search_str) != NULL) {[m
[32m+[m[32m            if (count == capacity) {[m
[32m+[m[32m                capacity *= 2;[m
[32m+[m[32m                char** temp = realloc(result, capacity * sizeof(char*));[m
[32m+[m[32m                if (temp == NULL) {[m
[32m+[m[32m                    for (int i = 0; i < count; i++) {[m
[32m+[m[32m                        free(result[i]);[m
[32m+[m[32m                    }[m
[32m+[m[32m                    free(result);[m
[32m+[m[32m                    return -1;[m
[32m+[m[32m                }[m
[32m+[m[32m                result = temp;[m
[32m+[m[32m            }[m
[32m+[m
[32m+[m[32m            int len = mystrlen(buffer);[m
[32m+[m[32m            result[count] = malloc(len + 1);[m
[32m+[m[32m            if (result[count] == NULL) {[m
[32m+[m[32m                return -1;[m
[32m+[m[32m            }[m
[32m+[m[32m            mystrcpy(result[count], buffer);[m
[32m+[m[32m            count++;[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    *matches = result;[m
[32m+[m[32m    return count;[m
[32m+[m[32m}[m
