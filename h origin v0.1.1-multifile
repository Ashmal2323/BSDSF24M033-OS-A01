[32m+[m[32m# src/Makefile — does the actual compiling and linking[m
[32m+[m
[32m+[m[32mCC = gcc[m
[32m+[m[32mCFLAGS = -Wall -I../include[m
[32m+[m[32mOBJDIR = ../obj[m
[32m+[m[32mBINDIR = ../bin[m
[32m+[m[32mTARGET = $(BINDIR)/client[m
[32m+[m
[32m+[m[32mSOURCES = mystrfunctions.c myfilefunctions.c main.c[m
[32m+[m[32mOBJECTS = $(SOURCES:%.c=$(OBJDIR)/%.o)[m
[32m+[m
[32m+[m[32m.PHONY: all clean[m
[32m+[m
[32m+[m[32mall: $(TARGET)[m
[32m+[m
[32m+[m[32m$(TARGET): $(OBJECTS)[m
[32m+[m	[32m$(CC) $(CFLAGS) $(OBJECTS) -o $(TARGET)[m
[32m+[m
[32m+[m[32m$(OBJDIR)/%.o: %.c[m
[32m+[m	[32m$(CC) $(CFLAGS) -c $< -o $@[m
[32m+[m
[32m+[m[32mclean:[m
[32m+[m	[32mrm -f $(OBJDIR)/*.o $(TARGET)[m
