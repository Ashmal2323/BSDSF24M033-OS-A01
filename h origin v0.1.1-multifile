[36m@@ -0,0 +1,40 @@[m
[32m+[m[32m#include "../include/mystrfunctions.h"[m
[32m+[m
[32m+[m[32mint mystrlen(const char* s) {[m
[32m+[m[32m    int count = 0;[m
[32m+[m[32m    while (s[count] != '\0') {[m
[32m+[m[32m        count++;[m
[32m+[m[32m    }[m
[32m+[m[32m    return count;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mint mystrcpy(char* dest, const char* src) {[m
[32m+[m[32m    int i = 0;[m
[32m+[m[32m    while (src[i] != '\0') {[m
[32m+[m[32m        dest[i] = src[i];[m
[32m+[m[32m        i++;[m
[32m+[m[32m    }[m
[32m+[m[32m    dest[i] = '\0';[m
[32m+[m[32m    return 0;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mint mystrncpy(char* dest, const char* src, int n) {[m
[32m+[m[32m    int i = 0;[m
[32m+[m[32m    while (i < n && src[i] != '\0') {[m
[32m+[m[32m        dest[i] = src[i];[m
[32m+[m[32m        i++;[m
[32m+[m[32m    }[m
[32m+[m[32m    dest[i] = '\0';[m
[32m+[m[32m    return 0;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mint mystrcat(char* dest, const char* src) {[m
[32m+[m[32m    int destLen = mystrlen(dest);[m
[32m+[m[32m    int i = 0;[m
[32m+[m[32m    while (src[i] != '\0') {[m
[32m+[m[32m        dest[destLen + i] = src[i];[m
[32m+[m[32m        i++;[m
[32m+[m[32m    }[m
[32m+[m[32m    dest[destLen + i] = '\0';[m
[32m+[m[32m    return 0;[m
[32m+[m[32m}[m
